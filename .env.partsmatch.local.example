# Copy to .env.partsmatch.local and paste your cookie (gitignored).
#
# In Chrome DevTools → Network → POST /api/match → Request Headers → Cookie,
# copy ONLY the AppServiceAuthSession value, then set ONE line like:
#
#   PARTSMATCH_AUTH_COOKIE=AppServiceAuthSession=PASTE_TOKEN_HERE
#
# Do NOT wrap in quotes. Do NOT paste the whole "Cookie:" header.
# After saving, restart: python opm-dev-server.py
PARTSMATCH_AUTH_COOKIE=AppServiceAuthSession=PASTE_TOKEN_HERE
