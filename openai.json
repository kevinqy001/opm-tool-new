      "/api/catalog/entries/{klass}/{brand}/{entry}/detail": {
        "get": {
          "summary": "Entry Detail Tuple",
          "description": "Raw-artifact detail for an accepted catalog entry, addressed by\nthe canonical `(class, brand, entry)` tuple.\n\nReturns `{id, review_status: \"committed\", pdf_url, draft, raw}` —\nthe **raw document** view, read directly from\n`product/entries/\u003Cclass\u003E/\u003Cstem\u003E.yaml`. The compiled catalog\n(`/api/catalog/lifecycle`) is the list-shape matching surface and\ndeliberately doesn't carry PDFs / snippets; this endpoint is what\nthe review UI uses for the detail panel.\n\nTuple addressing is the only detail address: nothing prevents two\nclasses from having the same `entry:` value (e.g. a controller\n`6700` and a pressure `6700`), so a bare-name lookup would be\nambiguous. Callers always carry the class/brand/entry triple.\n\nResolution is **by YAML body**, not by file stem — the stem is\nsanitized for filesystem hygiene (e.g. `KS98-1` is stored as\n`KS98_1_PMA.yaml`) and reconstructing that rule client-side is\nbrittle. See `_find_family_file`.",
          "operationId": "entry_detail_tuple_api_catalog_entries__klass___brand___entry__detail_get",
          "parameters": [
            {
              "name": "klass",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Klass"
              }
            },
            {
              "name": "brand",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Brand"
              }
            },
            {
              "name": "entry",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Entry"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "title": "Response Entry Detail Tuple Api Catalog Entries  Klass   Brand   Entry  Detail Get"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
