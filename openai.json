      "/api/catalog/lifecycle": {
        "get": {
          "summary": "Catalog Lifecycle",
          "description": "Read-only lifecycle summary of the accepted catalog —\n**compiled-catalog shape**, not the raw artifact view.\n\nPure read model over `state.catalog.entries`: entry identity,\nlifecycle status (`active`/`obsolete`), `supersedes` /\n`superseded_by`, and health flags. No PDF link, no source\nsnippets, no YAML text — those live in the raw artifact and are\nserved by `/api/catalog/entries/{class}/{brand}/{entry}/detail`.\nThe split mirrors the system's runtime-vs-review separation:\ncompiled catalog is matcher input; raw artifact is reviewer\ninput.\n\nResponse is sorted by (klass, entry) so the UI table has stable\norder without client-side sort state.",
          "operationId": "catalog_lifecycle_api_catalog_lifecycle_get",
